# Copy to .env next to docker-compose.yml, then fill in the secret.
#   cp .env.example .env && python3 -c "import secrets; print(secrets.token_urlsafe(64))"

# --- Django ---------------------------------------------------------------
# Django refuses to boot with DEBUG off until this is a real key, so an
# unreplaced placeholder fails loudly instead of shipping quietly.
DJANGO_SECRET_KEY=replace-me

# DJANGO_DEBUG is deliberately absent - docker-compose.yml pins it to False so
# a forgotten line here cannot put the box into debug mode.

# The hostnames Django will answer to. 127.0.0.1 is here for the container
# healthcheck, not for you.
DJANGO_ALLOWED_HOSTS=fp.qaam.work,localhost,127.0.0.1

# Where the browser loads the app from. Needed for the Django admin's CSRF
# check - a POST from https://fp.qaam.work is rejected without it.
CSRF_TRUSTED_ORIGINS=https://fp.qaam.work

# The UI calls /api on its own origin, so nothing cross-origin happens and this
# list stays empty in production. Fill it in only if you point another site
# at this API.
CORS_ALLOWED_ORIGINS=

# Mark cookies https-only. Leave this off while you are testing over plain
# http://<host>:8090 - with it on, the browser will not send the session cookie
# and the admin login will appear to silently fail. Turn it on once the tunnel
# is the only way in.
DJANGO_SECURE_COOKIES=False

# --- Domain ---------------------------------------------------------------
FLEET_CURRENCY=AED
FLEET_TIME_ZONE=Asia/Dubai

JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

MAX_IMPORT_FILE_BYTES=10485760

# --- Host -----------------------------------------------------------------
# The port the Cloudflare tunnel connects to.
FLEETPULSE_PORT=8090
